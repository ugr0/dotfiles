[core]
	editor = nvim
[init]
	defaultBranch = main
[pull]
	rebase = true
[ghq]
	# Repositories are cloned to ~/ghq/<host>/<owner>/<repo>
	root = ~/ghq
[credential "https://github.com"]
	helper =
	helper = !\"$HOME/.local/bin/mise\" exec -- gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !\"$HOME/.local/bin/mise\" exec -- gh auth git-credential

# Machine-specific settings (user.name / user.email etc.), not tracked
[include]
	path = ~/.config/git/config.local
